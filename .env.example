# ══════════════════════════════════════════════════════
# Fontaine — Environment Variables
# ══════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────
# PostgreSQL connection string (Neon free tier recommended)
# Sign up at https://neon.com and create a project
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Authentication (Auth.js v5) ──────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Application URL (set to your deployed URL in production)
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Set to true when behind a reverse proxy (Render, etc.)
AUTH_TRUST_HOST=true

# ── AI Provider ──────────────────────────────────────
# Ollama (local development): set URL to enable local AI
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"

# Force mock AI provider (set to "true" for cloud deployment)
# AI_MOCK="true"
